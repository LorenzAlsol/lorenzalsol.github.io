---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MaskSprites from '../components/MaskSprites.astro';
import Stage from '../components/Stage.astro';
import { site } from '../content/site';
import { masks } from '../content/masks';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const L = site.work.labels;
---
<Base>
  <MaskSprites />

  <header class="nav">
    <a class="brand" href="#top" aria-label={`${site.name}, back to the top`}>
      <span class="brand-mark" aria-hidden="true">{site.initials}</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {site.nav.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="nav-tools">
      <button type="button" class="chip" data-mask-chip aria-expanded="false" aria-controls="mask-panel">
        <svg viewBox="0 0 120 140" aria-hidden="true"><use href="#mask-playful" class="m-playful" data-chip-icon /></svg>
        <span class="chip-label">Change mask<span class="chip-now"> · <span data-chip-name>Playful</span></span></span>
        <span class="sr-only" data-chip-sr>Change mask</span>
        <span class="chip-caret" aria-hidden="true"></span>
      </button>
      <button type="button" class="theme-btn" data-theme-btn>
        <span class="theme-dot" aria-hidden="true"></span>
        <span data-theme-label>Light</span>
      </button>
      <div class="chip-panel" id="mask-panel" data-mask-panel hidden>
        <p>Wear a different mask. The same work, presented from a different perspective.</p>
        <fieldset class="panel-masks" style="border:0;margin:0;padding:0;min-width:0">
          <legend class="sr-only">Choose a perspective</legend>
          {masks.map((m) => (
            <label class="panel-opt">
              <input type="radio" name="mask-nav" value={m.id} checked={m.id === 'playful'} />
              <svg viewBox="0 0 120 140" aria-hidden="true"><use href={`#mask-${m.id}`} class={`m-${m.id}`} /></svg>
              <span>{m.name}</span>
            </label>
          ))}
        </fieldset>
      </div>
    </div>
  </header>

  <main id="main">
    <Stage />

    <section id="work" class="work" aria-labelledby="work-title">
      <div class="work-inner">
        <header class="work-head">
          <div>
            <p class="kicker">{site.work.kicker}</p>
            <h2 id="work-title">{site.work.title}</h2>
          </div>
          <p class="work-intro">{site.work.intro}</p>
        </header>

        <div class="work-layout" data-work>
          <div class="work-index" role="tablist" aria-label="Projects" aria-orientation="vertical">
            {projects.map((p, i) => (
              <button type="button" class="tab" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab>
                <span class="ti-title">{p.data.title}</span>
                <span class="ti-meta">{p.data.year} · {p.data.role}</span>
                <span class="ti-stack">{p.data.stack.join(' · ')}</span>
              </button>
            ))}
          </div>

          <div class="work-stage">
            {projects.map((p) => (
              <article class="panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} data-panel>
                <div class="media">
                  {p.data.image ? (
                    <Picture src={p.data.image} alt={p.data.imageAlt ?? ''} formats={['avif', 'webp']} widths={[640, 960, 1280, 1600]} sizes="(max-width: 859px) 100vw, 70vw" loading="lazy" />
                  ) : (
                    <div class="media-slot">
                      <strong>Screenshot or demo needed</strong>
                      <span>{p.data.title} · add an image in the project file (about 1600 × 1000)</span>
                    </div>
                  )}
                </div>

                <div class="case">
                  <h3>{p.data.title}</h3>
                  <p class="summary">{p.data.summary}</p>
                  <div class="case-grid">
                    <div class="case-main">
                      <section><h4>{L.problem}</h4><p>{p.data.problem}</p></section>
                      <section><h4>{L.users}</h4><p>{p.data.users}</p></section>
                      <section><h4>{L.contribution}</h4><ul>{p.data.contribution.map((c) => <li>{c}</li>)}</ul></section>
                      <section><h4>{L.decisions}</h4><ul class="decisions">{p.data.decisions.map((d) => <li><strong>{d.title}</strong> {d.detail}</li>)}</ul></section>
                    </div>
                    <aside class="case-side" aria-label={`${p.data.title}: ${L.facts.toLowerCase()} and ${L.links.toLowerCase()}`}>
                      <dl class="meta">
                        <div><dt>Role</dt><dd>{p.data.role}</dd></div>
                        <div><dt>Stack</dt><dd>{p.data.stack.join(', ')}</dd></div>
                        <div><dt>Year</dt><dd>{p.data.year}</dd></div>
                      </dl>
                      <ul class="proj-links">
                        {p.data.links.map((l, i) => (
                          <li><a class={i === 0 ? 'btn' : 'text-link'} href={l.href}>{i === 0 ? site.work.cta : l.label}<span class="sr-only">{i === 0 ? ` (${l.label}): ${p.data.title}` : `: ${p.data.title}`}</span></a></li>
                        ))}
                      </ul>
                    </aside>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Interim sections: functional and on-system, but not yet redesigned. -->
    <section id="about" class="interim about" aria-labelledby="about-title">
      <div class="interim-inner">
        <p class="kicker">{site.about.kicker}</p>
        <h2 id="about-title">{site.about.title}</h2>
        <div class="about-grid">
          <div class="slot"><span>Portrait needed<br />(about 4 × 5)</span></div>
          <div class="bio">
            {site.about.bio.map((para) => <p>{para}</p>)}
            <dl class="facts">
              {site.about.facts.map((f) => (
                <div class="fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="interim contact" aria-labelledby="contact-title">
      <div class="interim-inner">
        <p class="kicker">{site.contact.kicker}</p>
        <h2 id="contact-title">{site.contact.title}</h2>
        <p>{site.contact.line}</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="links">
          <a class="btn btn-quiet" href={site.github}>GitHub</a>
          <a class="btn btn-quiet" href={site.linkedin}>LinkedIn</a>
          <a class="btn btn-quiet" href={site.cv} download>Download CV</a>
          <a class="btn btn-quiet" href="#mask-picker" data-focus-picker>Try another perspective</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <span>&copy; {site.year} {site.name}</span>
    <a href="#top">Back to the top</a>
  </footer>
</Base>
