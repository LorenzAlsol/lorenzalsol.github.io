---
// The four masks as reusable symbols. Flat shapes, one shared outline, three fills each.
// Fills come from --ma / --mb / --mc, set per mask in hero.css (.m-fox, .m-dragon, ...).
// Use with: <svg viewBox="0 0 120 140"><use href="#mask-fox" class="m-fox" /></svg>
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="mask-fox" viewBox="0 0 120 140">
      <g style="stroke:var(--line);stroke-width:5;stroke-linejoin:round;stroke-linecap:round">
        <path d="M16 64 L28 8 L58 42 Z" style="fill:var(--ma)" />
        <path d="M104 64 L92 8 L62 42 Z" style="fill:var(--ma)" />
        <path d="M27 50 L31 24 L46 41 Z" style="fill:var(--mc);stroke-width:3" />
        <path d="M93 50 L89 24 L74 41 Z" style="fill:var(--mc);stroke-width:3" />
        <path d="M12 60 C32 38 88 38 108 60 L94 106 Q60 136 26 106 Z" style="fill:var(--ma)" />
        <path d="M12 60 L42 90 L26 106 Z" style="fill:var(--mc)" />
        <path d="M108 60 L78 90 L94 106 Z" style="fill:var(--mc)" />
        <path d="M44 100 L60 124 L76 100 Q60 110 44 100 Z" style="fill:var(--mc)" />
        <path d="M30 68 Q42 60 54 72 Q42 80 30 68 Z" style="fill:var(--line);stroke-width:2" />
        <path d="M90 68 Q78 60 66 72 Q78 80 90 68 Z" style="fill:var(--line);stroke-width:2" />
        <circle cx="60" cy="116" r="5" style="fill:var(--line)" />
      </g>
    </symbol>

    <symbol id="mask-dragon" viewBox="0 0 120 140">
      <g style="stroke:var(--line);stroke-width:5;stroke-linejoin:round;stroke-linecap:round">
        <path d="M24 52 Q4 26 26 4 Q28 30 44 44 Z" style="fill:var(--mb)" />
        <path d="M96 52 Q116 26 94 4 Q92 30 76 44 Z" style="fill:var(--mb)" />
        <path d="M12 56 Q60 28 108 56 L102 98 Q60 136 18 98 Z" style="fill:var(--ma)" />
        <path d="M22 60 L54 74 L54 64 Z" style="fill:var(--line);stroke-width:2" />
        <path d="M98 60 L66 74 L66 64 Z" style="fill:var(--line);stroke-width:2" />
        <circle cx="40" cy="78" r="7" style="fill:var(--mc);stroke-width:3" />
        <circle cx="80" cy="78" r="7" style="fill:var(--mc);stroke-width:3" />
        <circle cx="40" cy="78" r="2.5" style="fill:var(--line);stroke:none" />
        <circle cx="80" cy="78" r="2.5" style="fill:var(--line);stroke:none" />
        <path d="M44 92 L76 92 L70 112 L50 112 Z" style="fill:var(--mb)" />
        <circle cx="55" cy="101" r="2.4" style="fill:var(--line);stroke:none" />
        <circle cx="65" cy="101" r="2.4" style="fill:var(--line);stroke:none" />
        <path d="M30 114 L40 126 L50 116 L60 128 L70 116 L80 126 L90 114" style="fill:none" />
      </g>
    </symbol>

    <symbol id="mask-owl" viewBox="0 0 120 140">
      <g style="stroke:var(--line);stroke-width:5;stroke-linejoin:round;stroke-linecap:round">
        <path d="M20 46 L28 8 L54 36 Z" style="fill:var(--mb)" />
        <path d="M100 46 L92 8 L66 36 Z" style="fill:var(--mb)" />
        <ellipse cx="60" cy="80" rx="48" ry="52" style="fill:var(--ma)" />
        <circle cx="38" cy="74" r="21" style="fill:var(--mc)" />
        <circle cx="82" cy="74" r="21" style="fill:var(--mc)" />
        <circle cx="38" cy="74" r="10" style="fill:var(--line);stroke-width:2" />
        <circle cx="82" cy="74" r="10" style="fill:var(--line);stroke-width:2" />
        <circle cx="34" cy="70" r="3" style="fill:var(--mc);stroke:none" />
        <circle cx="78" cy="70" r="3" style="fill:var(--mc);stroke:none" />
        <path d="M52 94 L68 94 L60 112 Z" style="fill:var(--mb)" />
        <path d="M34 120 Q60 132 86 120" style="fill:none" />
      </g>
    </symbol>

    <symbol id="mask-stag" viewBox="0 0 120 140">
      <g style="fill:none;stroke-linecap:round;stroke-linejoin:round">
        <path d="M44 48 Q30 28 26 6 M36 32 L14 26 M31 20 L16 8 M76 48 Q90 28 94 6 M84 32 L106 26 M89 20 L104 8" style="stroke:var(--line);stroke-width:12" />
        <path d="M44 48 Q30 28 26 6 M36 32 L14 26 M31 20 L16 8 M76 48 Q90 28 94 6 M84 32 L106 26 M89 20 L104 8" style="stroke:var(--mc);stroke-width:5" />
      </g>
      <g style="stroke:var(--line);stroke-width:5;stroke-linejoin:round;stroke-linecap:round">
        <path d="M22 56 Q60 36 98 56 L86 108 Q60 134 34 108 Z" style="fill:var(--ma)" />
        <path d="M32 76 Q41 84 50 76" style="fill:none;stroke-width:4" />
        <path d="M70 76 Q79 84 88 76" style="fill:none;stroke-width:4" />
        <circle cx="52" cy="60" r="3" style="fill:var(--mc);stroke:none" />
        <circle cx="68" cy="60" r="3" style="fill:var(--mc);stroke:none" />
        <ellipse cx="60" cy="114" rx="9" ry="6.5" style="fill:var(--line)" />
      </g>
    </symbol>
  </defs>
</svg>
