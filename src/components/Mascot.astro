---
import { site } from '../content/site';

// Section ids double as keys into site.mascot.
const sections = site.nav.map((n) => ({ id: n.href.slice(1), label: n.label }));
---
<aside
  id="mascot"
  class="mascot"
  aria-label="Guide"
  data-mascot
  data-lines={JSON.stringify(site.mascot)}
  data-sections={JSON.stringify(sections)}
>
  <div class="mascot-bubble" id="mascot-bubble" data-bubble hidden>
    <p class="mascot-line" id="mascot-line" data-line aria-live="polite">{site.mascot.start[0]}</p>
    <div class="mascot-actions">
      <button type="button" class="mascot-btn" data-next>Next tip</button>
      <button type="button" class="mascot-btn mascot-btn-go" data-go>Go to {sections[1].label}</button>
      <button type="button" class="mascot-btn mascot-btn-quiet" data-hide>Hide</button>
    </div>
  </div>

  <button
    type="button"
    class="mascot-avatar"
    data-avatar-btn
    aria-controls="mascot-bubble"
    aria-expanded="false"
    aria-label={`${site.mascotName}, your guide. Show or hide tips.`}
  >
    <!-- MASCOT SLOT: src/mascot/avatar.ts mounts your character here. -->
    <span class="mascot-slot" data-avatar-slot>
      <svg class="mascot-art" data-avatar-art data-state="idle" viewBox="0 0 80 96" width="64" height="76" aria-hidden="true" focusable="false">
        <circle class="antenna-glow" cx="40" cy="8" r="13" fill="var(--gold)" opacity=".35" />
        <line x1="40" y1="10" x2="40" y2="28" stroke="var(--gold)" stroke-width="3" stroke-linecap="round" />
        <circle cx="40" cy="8" r="6" fill="var(--gold)" />
        <g class="body">
          <path d="M10 82c-5-28 8-54 30-54s35 26 30 54c-2 9-14 12-30 12S12 91 10 82z" fill="var(--page)" stroke="var(--gold)" stroke-width="3" />
          <circle cx="29" cy="58" r="4.5" fill="var(--ink)" />
          <circle cx="51" cy="58" r="4.5" fill="var(--ink)" />
          <path class="mouth" d="M32 72q8 7 16 0" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
        </g>
      </svg>
      <span class="mascot-slot-label">[Mascot slot]</span>
    </span>
  </button>
</aside>
<script>
  import '../scripts/mascot';
</script>
