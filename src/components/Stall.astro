---
// The hero's focal point: a mask seller's stall. The seller is the mascot; the four masks on
// the rack are the control for choosing an experience. Radio inputs sit over the drawing, so
// the picker is native: one tab stop, arrow keys, and it works by tap as well as hover.
//
// ARTWORK SLOT: seller poses and masks are plain SVG below. To swap in final art, replace the
// <g class="seller"> group (keep the .arm-hold / .arm-present / .arm-idle pose groups) and the
// symbols in MaskSprites.astro. Nothing else depends on their shapes.
import { masks } from '../content/masks';

const stripes = Array.from({ length: 10 }, (_, i) => i);
const slotX = [452, 584, 716, 848]; // rack hook x positions in scene units

// Deterministic pines for the stag backdrop.
let s = 5;
const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const pines = Array.from({ length: 26 }, (_, i) => {
  const h = 70 + rnd() * 90, w = 44 + rnd() * 18, x = i * 40 - 10;
  return `M${x} 560 L${x + w / 2} ${560 - h} L${x + w} 560 Z`;
}).join(' ');
---
<div class="stall" data-stall>
  <div class="stall-frame">
    <svg class="scene" viewBox="0 0 1000 760" role="img" aria-label="A mask seller behind his counter. Four animal masks hang on the rack beside him.">
      <defs>
        <clipPath id="scene-clip"><rect width="1000" height="760" rx="30" /></clipPath>
      </defs>
      <g clip-path="url(#scene-clip)">
        <rect class="sky" width="1000" height="760" />

        <!-- Backdrops: one per mask, shown by [data-mask] -->
        <g class="bd bd-fox">
          <circle class="sun" cx="770" cy="200" r="96" />
          <path class="far" d="M0 470 Q250 360 500 450 T1000 430 V760 H0 Z" />
          <path class="near" d="M0 540 Q300 450 620 520 T1000 500 V760 H0 Z" />
          <path class="conf" d="M150 330 l14 -24 l14 24 z M330 260 l12 -20 l12 20 z M640 330 l12 -20 l12 20 z M900 360 l14 -24 l14 24 z" />
        </g>
        <g class="bd bd-dragon">
          <circle class="ring" cx="790" cy="190" r="84" />
          <path class="far" d="M0 520 L160 330 L260 440 L400 280 L560 470 L700 320 L860 450 L1000 380 V760 H0 Z" />
          <path class="near" d="M0 590 L200 440 L330 520 L520 410 L720 540 L880 470 L1000 520 V760 H0 Z" />
          <rect class="conf" x="90" y="190" width="260" height="14" rx="7" />
          <rect class="conf" x="150" y="236" width="180" height="14" rx="7" />
        </g>
        <g class="bd bd-owl">
          <circle class="sun" cx="790" cy="190" r="70" />
          <circle class="sky" cx="822" cy="170" r="62" />
          <path class="far" d="M0 560 Q500 470 1000 560 V760 H0 Z" />
          <path class="near" d="M0 620 Q500 540 1000 620 V760 H0 Z" />
          <path class="conf" d="M110 210 L220 170 L330 240 L420 190" style="fill:none;stroke:var(--accent2);stroke-width:3" />
          <circle class="starp" cx="110" cy="210" r="6" /><circle class="starp" cx="220" cy="170" r="6" />
          <circle class="starp" cx="330" cy="240" r="6" /><circle class="starp" cx="420" cy="190" r="6" />
          <circle class="starp" cx="620" cy="130" r="4" /><circle class="starp" cx="540" cy="220" r="4" />
        </g>
        <g class="bd bd-stag">
          <circle class="sun" cx="760" cy="210" r="80" />
          <path class="far" d={pines} />
          <rect class="mist" x="0" y="440" width="1000" height="70" />
          <rect class="mist" x="0" y="520" width="1000" height="90" />
          <path class="near" d="M0 600 Q500 560 1000 600 V760 H0 Z" />
        </g>

        <!-- Posts and rack beam -->
        <rect class="wood" x="26" y="90" width="26" height="580" />
        <rect class="wood" x="948" y="90" width="26" height="580" />
        <rect class="wood" x="372" y="228" width="550" height="22" rx="6" />
        {masks.map((m, i) => (
          <g class={`rack-mask rm-${m.id}`}>
            <path class="hook" d={`M${slotX[i]} 250 L${slotX[i]} 276`} />
            <use href={`#mask-${m.id}`} class={`m-${m.id}`} x={slotX[i] - 63} y="268" width="126" height="147" />
            <ellipse class="ghost" cx={slotX[i]} cy="342" rx="58" ry="68" />
          </g>
        ))}

        <!-- Seller -->
        <g class="seller">
          <path class="coat" d="M150 650 L158 566 Q230 534 302 566 L310 650 Z" />
          <path class="vest" d="M200 556 L260 556 L272 650 L188 650 Z" />
          <circle class="skin" cx="176" cy="488" r="11" /><circle class="skin" cx="284" cy="488" r="11" />
          <circle class="skin" cx="230" cy="484" r="52" />
          <path class="hair" d="M200 508 Q214 496 230 505 Q246 496 260 508 Q246 522 230 514 Q214 522 200 508 Z" />
          <circle class="eye" cx="212" cy="480" r="5.5" /><circle class="eye" cx="248" cy="480" r="5.5" />
          <path class="brow" d="M202 466 L222 462 M238 462 L258 466" />
          <path class="mouth" d="M219 525 Q230 532 241 525" />
          <ellipse class="hat" cx="230" cy="448" rx="82" ry="14" />
          <path class="hat" d="M178 448 Q180 388 230 384 Q280 388 282 448 Z" />
          <path class="band" d="M180 436 Q230 450 280 436 L281 446 Q230 460 179 446 Z" />

          <!-- Left arm rests on the counter -->
          <path class="arm-out" d="M168 572 L134 612" /><path class="arm-in" d="M168 572 L134 612" />
          <circle class="hand" cx="150" cy="612" r="16" />

          <!-- Right arm: three poses, switched by CSS -->
          <g class="arm arm-hold">
            <path class="arm-out" d="M294 572 L348 524 L334 452" /><path class="arm-in" d="M294 572 L348 524 L334 452" />
            {masks.map((m) => (
              <use href={`#mask-${m.id}`} class={`held m-${m.id} held-${m.id}`} x="286" y="378" width="92" height="107" />
            ))}
            <circle class="hand" cx="334" cy="452" r="17" />
          </g>
          <g class="arm arm-present">
            <path class="arm-out" d="M294 572 L354 544 L436 400" /><path class="arm-in" d="M294 572 L354 544 L436 400" />
            <circle class="hand" cx="438" cy="392" r="17" />
          </g>
          <g class="arm arm-idle">
            <path class="arm-out" d="M294 572 L330 610 L320 616" /><path class="arm-in" d="M294 572 L330 610 L320 616" />
            <circle class="hand" cx="318" cy="614" r="16" />
          </g>
        </g>

        <!-- Counter -->
        <rect class="counter" x="40" y="632" width="920" height="140" />
        <path class="plank" d="M300 640 V772 M580 640 V772 M800 640 V772" />
        <rect class="counter-top" x="24" y="618" width="952" height="26" rx="8" />

        <!-- Awning -->
        <g class="awning">
          {stripes.map((i) => (
            <g class={i % 2 ? 'awn-b' : 'awn-a'}>
              <rect x={i * 100} y="-4" width="100" height="104" />
              <circle cx={i * 100 + 50} cy="100" r="50" />
            </g>
          ))}
        </g>
      </g>
      <rect class="frame-line" width="1000" height="760" rx="30" />
    </svg>

    <fieldset class="picker" data-picker>
      <legend class="sr-only">Choose a mask</legend>
      {masks.map((m, i) => (
        <label class={`mask-opt mo-${m.id}`} style={`--cx:${slotX[i] / 10}%`}>
          <input type="radio" name="mask" value={m.id} checked={m.id === 'fox'} />
          <span class="mask-chip">
            <span class="mask-name">{m.name}</span>
            <span class="mask-mood">{m.mood}</span>
          </span>
          <span class="mask-worn" aria-hidden="true">Wearing</span>
        </label>
      ))}
    </fieldset>
  </div>

  <p class="caption" aria-live="polite">
    {masks.map((m) => (
      <span class={`cap cap-cur cap-cur-${m.id}`}><strong>Wearing the {m.name}.</strong> {m.change}</span>
    ))}
    {masks.map((m) => (
      <span class={`cap cap-prev cap-prev-${m.id}`}><strong>Try the {m.name}:</strong> {m.mood.toLowerCase()}. {m.change}</span>
    ))}
  </p>
</div>
